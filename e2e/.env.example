# Entorno de las pruebas end-to-end. Solo NOMBRES: copia como e2e/.env (ignorado
# por git) y completa los valores en tu maquina. Nada de valores reales aqui.

# URL del frontend. Por defecto: http://localhost:5173
E2E_BASE_URL=

# URL base de la API. Por defecto: http://localhost:8080/api
E2E_API_URL=

# Credenciales del administrador (obligatorias: sin ellas las pruebas fallan)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Pausa en milisegundos por accion para grabar demostraciones. Por defecto: 0
E2E_SLOWMO=
