# =============================================================================
# MediTrack Senior - variables de entorno de EJEMPLO (SI se versiona, sin secretos)
# Copia este archivo a `.env` en la raiz y completa los valores en local.
# En Azure (App Service / Database for PostgreSQL) se configuran como
# "Application Settings". NUNCA subas el archivo `.env` real.
# =============================================================================

# --- PostgreSQL (consumido por docker-compose.yml) ---
POSTGRES_DB=meditrack
POSTGRES_USER=meditrack
POSTGRES_PASSWORD=cambia_esta_password

# --- Conexion del backend a PostgreSQL (application-dev.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/meditrack
DB_USER=meditrack
DB_PASSWORD=cambia_esta_password

# --- JWT (pasos posteriores; se reservan los nombres) ---
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRATION_MINUTES=60

# --- CORS (pasos posteriores) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
