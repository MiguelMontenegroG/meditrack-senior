<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.uniquindio</groupId>
    <artifactId>meditrack-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>meditrack-backend</name>
    <description>Backend de MediTrack Senior (monolito modular, arquitectura hexagonal)</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.4</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- OpenPDF 3.0.5: generacion de PDF (modulo reporte). Licencia dual
             LGPL 2.1 / MPL 2.0 (iText 7 es AGPL). Target Java 21, compatible
             con Spring Boot 3.4.1. Publicada el 2026-05-22. -->
        <openpdf.version>3.0.5</openpdf.version>
        <!-- JaCoCo 0.8.16: cobertura de pruebas. Version estable publicada el
             2026-10-26 (mas de dos semanas de antiguedad) y compatible con Java
             21 (soporte de class files 21 desde 0.8.11). Plugin oficial de la
             Eclipse Foundation; no agrega nada al artefacto final. -->
        <jacoco.version>0.8.16</jacoco.version>
    </properties>

    <dependencies>
        <!-- Web: controladores REST de los modulos (API bajo /api) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistencia JPA: repositorios de infraestructura/persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: validacion de DTOs de entrada (jakarta.validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator: endpoint de salud /actuator/health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Security: autenticacion stateless con JWT, BCrypt y
             method security (@PreAuthorize). Version gestionada por el parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- jjwt 0.12.6: firma y validacion de JWT (HS256).
             - jjwt-api: interfaz en compilacion.
             - jjwt-impl / jjwt-jackson: implementacion y serializacion JSON en runtime.
             Se elige 0.12.6 por ser la ultima version estable de la serie 0.12.x. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: versionado y aplicacion de migraciones sobre PostgreSQL -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Soporte de Flyway especifico para PostgreSQL (requerido en Flyway 10+) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Driver JDBC de PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- springdoc-openapi: documentacion y Swagger UI (solo util en dev) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- OpenPDF 3.0.5: unica libreria de generacion de PDF (modulo reporte).
             LGPL 2.1 / MPL 2.0, target Java 21. Su uso queda confinado al
             adaptador de infraestructura GeneradorPdfOpenPdfAdapter. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- Lombok: reduce getters/setters/constructores en entidades y DTOs.
             Justificado: evita codigo repetitivo y ruido; el APT corre en compilacion.
             No incluir Lombok en el artefacto final. -->
        <dependency>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de seguridad web (MockMvc con usuarios/roles simulados). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: levanta un PostgreSQL efimero en las pruebas de
             integracion de la capa de persistencia. Permite ejecutar las
             consultas reales (JPQL) contra el mismo motor que produccion
             (PostgreSQL), detectando errores que las pruebas con mocks no
             ven. Version 1.20.4, compatible con Spring Boot 3.4.1. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <!-- @ServiceConnection de Spring Boot para Testcontainers. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- JaCoCo (org.jacoco:jacoco-maven-plugin ${jacoco.version}).
                 prepare-agent instrumenta la JVM de pruebas (via argLine) y
                 report, en la fase verify, genera los informes que consume
                 Sonar: target/site/jacoco/jacoco.xml. Se excluyen clases sin
                 logica propia para que la cifra refleje codigo realmente
                 probable:
                 - la clase principal (MeditrackApplication): solo main().
                 - *Request / *Response: DTOs de entrada/salida sin logica.
                 - config/**: wiring de Spring (cableado de beans, seguridad,
                   propiedades); se ejercita al levantar el contexto, no con
                   pruebas unitarias directas.
                 - *Entity: mapeo JPA (getters/setters generados por Lombok). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/MeditrackApplication.class</exclude>
                        <exclude>**/*Request.class</exclude>
                        <exclude>**/*Response.class</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/*Entity.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                                <format>HTML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
